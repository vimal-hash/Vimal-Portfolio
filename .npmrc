# `shamefully-hoist=true` makes pnpm's node_modules look flat like npm's.
# Required because @react-three/drei has deep dependencies (three-stdlib,
# postprocessing internals, etc.) that resolve via implicit module lookups.
# Without flat hoisting, these resolve to `undefined` at runtime and crash
# with "Cannot read properties of undefined (reading 'call')".
#
# This is the pnpm-recommended workaround for legacy npm-flat dependency
# graphs. See: https://pnpm.io/npmrc#shamefully-hoist
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true
